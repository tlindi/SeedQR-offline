{
  "parserOptions": {
    "ecmaVersion": 5,
    "sourceType": "script"
  },
  "env": {
    "browser": true,
    "es5": true
  },
  "rules": {
    "no-var": "off",
    "no-const": "error",
    "no-let": "error",
    "no-arrow-functions": "error",
    "no-class": "error",
    "no-template-literals": "error",
    "no-rest-parameters": "error",
    "no-spread": "error",
    "no-destructuring": "error"
  }
}